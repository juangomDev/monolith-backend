# Servidor y Entorno
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
BASE_URL=http://localhost:8080

# Base de Datos PostgreSQL
DB_NAME=monolith_db
DB_ADMIN_USER=postgres_admin
DB_ADMIN_PASSWORD=change_this_admin_password_in_production
DB_APP_USER=monolith_app_user
DB_APP_PASSWORD=change_this_app_password_in_production

# URL de conexión para la aplicación (usuario con privilegios CRUD)
DATABASE_URL=postgresql://monolith_app_user:change_this_app_password_in_production@localhost:5432/monolith_db?schema=public

# Seguridad y Claves
API_KEY_PEPPER=change_this_pepper_to_a_long_random_secret_string_32_chars_min

# Almacenamiento local / volumen Dokploy
STORAGE_DIR=./storage
MAX_STORAGE_GB=50

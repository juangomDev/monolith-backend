# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DEL MONOLITO (.env.example)
# Copia este archivo a .env y ajusta los valores según tu entorno (Local / Dokploy)
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. SERVIDOR Y ENTORNO
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL
# Formato: postgresql://[usuario]:[password]@[host]:[puerto]/[nombre_db]?schema=public
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://monolith_app_user:change_this_app_password_in_production@localhost:5432/monolith_db?schema=public"

# ------------------------------------------------------------------------------
# 2. SEGURIDAD, HASHING Y CORS
# API_KEY_PEPPER: Secreto para HMAC-SHA256 de X-API-Key (mínimo 16 caracteres)
# CORS_ALLOWED_ORIGINS: Orígenes extra separados por coma (ej. https://app.midominio.com)
# ------------------------------------------------------------------------------
API_KEY_PEPPER="change_this_pepper_to_a_long_random_secret_string_32_chars_min"
CORS_ALLOWED_ORIGINS=""

# ------------------------------------------------------------------------------
# 3. ALMACENAMIENTO DE ARCHIVOS
# Desarrollo local: ./storage | Producción en contenedor Dokploy: /app/storage
# ------------------------------------------------------------------------------
STORAGE_DIR="./storage"
MAX_STORAGE_GB=50

# ------------------------------------------------------------------------------
# 4. AUTENTICACIÓN JWT Y CUENTAS ESTRUCTURALES DEL SISTEMA
# IMPORTANTE: En NODE_ENV=production es obligatorio cambiar JWT_SECRET y ADMIN_PASSWORD
# ------------------------------------------------------------------------------
JWT_SECRET="development_jwt_secret_must_be_long_and_safe_32_chars"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="AdminPass123!"

# Cuenta fija de servicio para el Interruptor de Publicación de IA (Fase 14.7)
AI_MANAGER_USERNAME="ai_manager"
AI_MANAGER_PASSWORD="AiManagerPass123!"

# ------------------------------------------------------------------------------
# 5. CHAT ANALÍTICO E INTELIGENCIA ARTIFICIAL (FASE 14 - GOOGLE AI STUDIO)
# Si AI_API_KEY se deja vacío, el chat responde con el Fallback Determinista Local
# ------------------------------------------------------------------------------
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
AI_FALLBACK_MODEL="gemini-2.5-flash-lite"


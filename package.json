{
  "name": "monolith-backend",
  "version": "1.0.0",
  "description": "Backend monolítico modular para ingesta y procesamiento seguro de imágenes y tablas",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "fastify",
    "typescript",
    "prisma",
    "postgresql",
    "dokploy"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@prisma/client": "6.4.1",
    "exceljs": "^4.4.0",
    "fast-csv": "^5.0.8",
    "fastify": "^5.12.7",
    "file-type": "^22.2.0",
    "lru-cache": "^11.5.3",
    "nanoid": "^6.0.2",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/yauzl": "^3.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "6.4.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }

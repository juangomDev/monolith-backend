datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Clientes con acceso a la API
model ApiClient {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  keyPrefix String   @map("key_prefix") @db.VarChar(16)
  keyHash   String   @unique @map("key_hash") // HMAC-SHA256
  rateLimit Int      @default(100) @map("rate_limit")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([keyHash])
  @@map("api_clients")
}

// 2. Registro de imágenes
model ImageRegistry {
  id           String   @id @default(uuid()) @db.Uuid
  shortCode    String   @unique @map("short_code") @db.VarChar(12)
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  storagePath  String   @map("storage_path")
  folderId     String?  @map("folder_id") @db.Uuid
  folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([shortCode])
  @@index([folderId])
  @@map("images_registry")
}

// 3. Registro de tablas (CSV / Excel)
model TableRegistry {
  id            String   @id @default(uuid()) @db.Uuid
  shortCode     String   @unique @map("short_code") @db.VarChar(12)
  tableName     String   @map("table_name")
  rowCount      Int      @default(0) @map("row_count")
  columnsSchema Json?    @map("columns_schema") @db.JsonB
  sizeBytes     Int      @map("size_bytes")
  storagePath   String   @map("storage_path")
  folderId      String?  @map("folder_id") @db.Uuid
  folder        Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([shortCode])
  @@index([folderId])
  @@map("tables_registry")
}

// 4. Roles y Usuarios del sistema
enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  tokenVersion Int      @default(0) @map("token_version")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  folders      Folder[]

  @@index([username])
  @@map("users")
}

// 5. Carpetas y Proyectos Compartidos
enum FolderType {
  IMAGE
  TABLE
}

model Folder {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @db.VarChar(60)
  type      FolderType
  color     String?         @db.VarChar(20)
  isPrivate Boolean         @default(false) @map("is_private")
  userId    String          @map("user_id") @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now()) @map("created_at")
  images    ImageRegistry[]
  tables    TableRegistry[]

  @@index([type])
  @@index([userId])
  @@index([isPrivate])
  @@map("folders")
}

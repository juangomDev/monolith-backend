datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Clientes con acceso a la API
model ApiClient {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  keyPrefix   String    @map("key_prefix") @db.VarChar(16)
  keyHash     String    @unique @map("key_hash") // HMAC-SHA256
  rateLimit   Int       @default(100) @map("rate_limit")
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([keyHash])
  @@map("api_clients")
}

// 2. Registro de imágenes
model ImageRegistry {
  id           String   @id @default(uuid()) @db.Uuid
  shortCode    String   @unique @map("short_code") @db.VarChar(12)
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  width        Int?     @map("width")
  height       Int?     @map("height")
  storagePath  String   @map("storage_path")
  folderId     String?  @map("folder_id") @db.Uuid
  folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([shortCode])
  @@index([folderId])
  @@map("images_registry")
}

// 3. Registro de tablas (CSV / Excel)
model TableRegistry {
  id            String   @id @default(uuid()) @db.Uuid
  shortCode     String   @unique @map("short_code") @db.VarChar(12)
  tableName     String   @map("table_name")
  rowCount      Int      @default(0) @map("row_count")
  columnsSchema Json?    @map("columns_schema") @db.JsonB
  metadataCard  Json?    @map("metadata_card") @db.JsonB
  sizeBytes     Int      @map("size_bytes")
  storagePath   String   @map("storage_path")
  folderId      String?  @map("folder_id") @db.Uuid
  folder        Folder?         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  formDefinition FormDefinition?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([shortCode])
  @@index([folderId])
  @@map("tables_registry")
}

// 3.1. Registro de documentos PDF (Doble Artefacto: .pdf + .text.json.gz)
model PdfRegistry {
  id               String   @id @default(uuid()) @db.Uuid
  shortCode        String   @unique @map("short_code") @db.VarChar(12)
  originalName     String   @map("original_name")
  storagePath      String   @map("storage_path")
  textArtifactPath String   @map("text_artifact_path")
  sizeBytes        Int      @map("size_bytes")
  pageCount        Int      @default(0) @map("page_count")
  isScanned        Boolean  @default(false) @map("is_scanned")
  metadataCard     Json?    @map("metadata_card") @db.JsonB
  folderId         String?  @map("folder_id") @db.Uuid
  folder           Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([shortCode])
  @@index([folderId])
  @@map("pdf_registry")
}

// 4. Roles y Usuarios del sistema
enum Role {
  ADMIN
  MANAGER
  COLLABORATOR
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  username     String         @unique @db.VarChar(50)
  passwordHash String         @map("password_hash")
  role         Role           @default(MANAGER)
  tokenVersion Int            @default(0) @map("token_version")
  isActive     Boolean        @default(true) @map("is_active")
  createdById  String?        @map("created_by_id") @db.Uuid
  createdBy    User?          @relation("CreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now()) @map("created_at")

  createdUsers      User[]         @relation("CreatedUsers")
  folders           Folder[]
  folderMemberships FolderMember[]
  resolvedEntries   FormEntry[]    @relation("ResolvedEntries")

  @@index([username])
  @@index([createdById])
  @@map("users")
}

// 5. Carpetas y Proyectos Compartidos
enum FolderType {
  IMAGE
  TABLE
  PDF
}

enum FolderPermission {
  READ
  EDIT
}

model Folder {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @db.VarChar(60)
  type      FolderType
  color     String?         @db.VarChar(20)
  isPrivate Boolean         @default(false) @map("is_private")
  userId    String          @map("user_id") @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now()) @map("created_at")
  images    ImageRegistry[]
  tables    TableRegistry[]
  pdfs      PdfRegistry[]
  forms     FormDefinition[]
  members   FolderMember[]

  @@index([type])
  @@index([userId])
  @@index([isPrivate])
  @@map("folders")
}

// 6. Membresías y permisos de carpetas compartidas
model FolderMember {
  id         String           @id @default(uuid()) @db.Uuid
  folderId   String           @map("folder_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  permission FolderPermission @default(READ)
  createdAt  DateTime         @default(now()) @map("created_at")

  folder     Folder           @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
  @@index([folderId])
  @@index([userId])
  @@map("folder_members")
}

// 7. Historial y Trazabilidad de Auditoría
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  actorUsername String   @map("actor_username") @db.VarChar(50)
  action        String   @db.VarChar(60)
  resourceType  String   @map("resource_type") @db.VarChar(40)
  resourceId    String?  @map("resource_id") @db.VarChar(80)
  folderId      String?  @map("folder_id") @db.Uuid
  metadata      Json?    @db.JsonB
  ipAddress     String?  @map("ip_address") @db.VarChar(60)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([folderId])
  @@index([resourceType, resourceId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// 8. Módulo de Formularios Customizables y Tablas Vivas
model FormDefinition {
  id                      String         @id @default(uuid()) @db.Uuid
  slug                    String         @unique @db.VarChar(80)
  title                   String         @db.VarChar(120)
  entryFieldsSchema       Json           @map("entry_fields_schema") @db.JsonB
  resolutionFieldsSchema  Json           @map("resolution_fields_schema") @db.JsonB
  allowedResolutionStates String[]       @default(["VALID", "INVALID"]) @map("allowed_resolution_states")
  autoResolveWithAi       Boolean        @default(false) @map("auto_resolve_with_ai")
  externalTargetUrl       String?        @map("external_target_url")
  folderId                String         @map("folder_id") @db.Uuid
  folder                  Folder         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  linkedTableId           String?        @unique @map("linked_table_id") @db.Uuid
  linkedTable             TableRegistry? @relation(fields: [linkedTableId], references: [id], onDelete: SetNull)
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @default(now()) @updatedAt @map("updated_at")
  entries                 FormEntry[]

  @@index([slug])
  @@index([folderId])
  @@map("form_definitions")
}

model FormEntry {
  id                String         @id @default(uuid()) @db.Uuid
  formId            String         @map("form_id") @db.Uuid
  form              FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)
  entryPayload      Json           @map("entry_payload") @db.JsonB
  status            String         @default("NEW") @db.VarChar(50)
  resolutionPayload Json?          @map("resolution_payload") @db.JsonB
  resolvedById      String?        @map("resolved_by_id") @db.Uuid
  resolvedBy        User?          @relation("ResolvedEntries", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?      @map("resolved_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([formId])
  @@index([status])
  @@index([createdAt])
  @@map("form_entries")
}
